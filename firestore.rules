rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdmin() {
      return googleUser() && request.auth.token.email_verified == true
        && request.auth.token.email == 'philip.sadenfors@gmail.com';
    }

    match /restaurants/{restaurantId} {
      allow read: if googleUser();
      allow create: if googleUser()
        && request.resource.data.keys().hasOnly(['name','createdBy','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if googleUser() && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    match /weeks/{weekId}/days/{dayId}/reactions/{reactionId} {
      allow read: if googleUser();
      allow create, update: if googleUser()
        && weekId.matches('^[0-9]{4}-W[0-9]{2}
      allow read: if googleUser();
      allow create: if googleUser()
        && weekId.matches('^[0-9]{4}-W[0-9]{2}$')
        && dayId in ['0','1','2','3','4']
        && request.resource.data.keys().hasOnly(['senderName','text','createdBy','createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() >= 1
        && request.resource.data.senderName.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /weeks/{weekId}/days/{dayId}/votes/{voterId} {
      allow read: if googleUser();
      allow create: if googleUser()
        && voterId == request.auth.uid
        && weekId.matches('^[0-9]{4}-W[0-9]{2}$')
        && dayId in ['0','1','2','3','4']
        && request.resource.data.keys().hasOnly(['nameKey','voterName','restaurantId','createdBy','createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.voterName is string
        && request.resource.data.voterName.size() >= 2
        && request.resource.data.voterName.size() <= 35
        && request.resource.data.nameKey is string
        && request.resource.data.nameKey.size() >= 2
        && request.resource.data.nameKey.size() <= 120
        && request.resource.data.restaurantId is string
        && request.resource.data.restaurantId.size() >= 1
        && request.resource.data.restaurantId.size() <= 120
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (googleUser()
        && voterId == request.auth.uid
        && resource.data.createdBy == request.auth.uid);
    }
  }
})
        && dayId in ['0','1','2','3','4']
        && request.resource.data.keys().hasOnly(['createdBy','restaurantId','emoji'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.restaurantId is string
        && request.resource.data.restaurantId.size() >= 1
        && request.resource.data.restaurantId.size() <= 120
        && reactionId == request.auth.uid + '_' + request.resource.data.restaurantId
        && request.resource.data.emoji in ['🔥','😍','🤮','💸']
        && (!exists(/databases/$(database)/documents/weeks/$(weekId)/days/$(dayId)/reactions/$(reactionId)) || resource.data.createdBy == request.auth.uid);
      allow delete: if googleUser() && resource.data.createdBy == request.auth.uid;
    }
    match /weeks/{weekId}/days/{dayId}/chat/{messageId} {
      allow read: if googleUser();
      allow create: if googleUser()
        && weekId.matches('^[0-9]{4}-W[0-9]{2}$')
        && dayId in ['0','1','2','3','4']
        && request.resource.data.keys().hasOnly(['senderName','text','createdBy','createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() >= 1
        && request.resource.data.senderName.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /weeks/{weekId}/days/{dayId}/votes/{voterId} {
      allow read: if googleUser();
      allow create: if googleUser()
        && voterId == request.auth.uid
        && weekId.matches('^[0-9]{4}-W[0-9]{2}$')
        && dayId in ['0','1','2','3','4']
        && request.resource.data.keys().hasOnly(['nameKey','voterName','restaurantId','createdBy','createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.voterName is string
        && request.resource.data.voterName.size() >= 2
        && request.resource.data.voterName.size() <= 35
        && request.resource.data.nameKey is string
        && request.resource.data.nameKey.size() >= 2
        && request.resource.data.nameKey.size() <= 120
        && request.resource.data.restaurantId is string
        && request.resource.data.restaurantId.size() >= 1
        && request.resource.data.restaurantId.size() <= 120
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (googleUser()
        && voterId == request.auth.uid
        && resource.data.createdBy == request.auth.uid);
    }
  }
}