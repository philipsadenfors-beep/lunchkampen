rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function visitor(){return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';}
  function validDay(weekId,dayId){return weekId.matches('^[0-9]{4}-W[0-9]{2}$') && dayId in ['0','1','2','3','4'];}
  function validChat(){
   return request.resource.data.keys().hasOnly(['senderName','text','createdBy','createdAt'])
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.senderName is string && request.resource.data.senderName.size() >= 1 && request.resource.data.senderName.size() <= 60
    && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
    && request.resource.data.createdAt == request.time;
  }
  match /restaurants/{restaurantId} {
   allow read: if visitor();
   allow create: if visitor() && request.resource.data.keys().hasOnly(['name','createdBy','createdAt'])
    && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
    && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
   allow delete: if visitor() && resource.data.createdBy == request.auth.uid;
   allow update: if false;
  }
  match /weeks/{weekId}/days/{dayId}/votes/{voterId} {
   allow read: if visitor();
   allow create: if visitor() && validDay(weekId,dayId) && voterId == request.auth.uid
    && request.resource.data.keys().hasOnly(['nameKey','voterName','restaurantId','createdBy','createdAt'])
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.voterName is string && request.resource.data.voterName.size() >= 2 && request.resource.data.voterName.size() <= 35
    && request.resource.data.nameKey is string && request.resource.data.nameKey.size() >= 2 && request.resource.data.nameKey.size() <= 120
    && request.resource.data.restaurantId is string && request.resource.data.restaurantId.size() >= 1 && request.resource.data.restaurantId.size() <= 120
    && request.resource.data.createdAt == request.time;
   allow update: if false;
   allow delete: if visitor(); // OBS: Demo-admin kräver öppna raderingsrättigheter. INTE SÄKERT.
  }
  match /weeks/{weekId}/days/{dayId}/reactions/{reactionId} {
   allow read: if visitor();
   allow create: if visitor() && validDay(weekId,dayId)
    && request.resource.data.keys().hasOnly(['createdBy','restaurantId','emoji'])
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.restaurantId is string && request.resource.data.restaurantId.size() >= 1 && request.resource.data.restaurantId.size() <= 120
    && reactionId == request.auth.uid + '_' + request.resource.data.restaurantId
    && request.resource.data.emoji in ['🔥','😍','🤮','💸'];
   allow update: if visitor() && resource.data.createdBy == request.auth.uid
    && request.resource.data.createdBy == request.auth.uid && request.resource.data.restaurantId == resource.data.restaurantId
    && request.resource.data.keys().hasOnly(['createdBy','restaurantId','emoji'])
    && request.resource.data.emoji in ['🔥','😍','🤮','💸'];
   allow delete: if visitor() && resource.data.createdBy == request.auth.uid;
  }
  match /weeks/{weekId}/days/{dayId}/chat/{messageId} {
   allow read: if visitor();
   allow create: if visitor() && validDay(weekId,dayId) && validChat();
   allow update, delete: if false;
  }
  match /weeks/{weekId}/days/{dayId}/awChat/{messageId} {
   allow read: if visitor();
   allow create: if visitor() && validDay(weekId,dayId) && validChat();
   allow update, delete: if false;
  }
  match /weeks/{weekId}/days/{dayId}/awAttendees/{attendeeId} {
   allow read: if visitor();
   allow create: if visitor() && validDay(weekId,dayId) && attendeeId == request.auth.uid
    && request.resource.data.keys().hasOnly(['name','createdBy','createdAt'])
    && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 35
    && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
   allow update: if false;
   allow delete: if visitor() && attendeeId == request.auth.uid && resource.data.createdBy == request.auth.uid;
  }
 }
}